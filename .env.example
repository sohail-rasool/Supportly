# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this template is committed so others know which variables are needed.

# PostgreSQL connection string, used by Prisma (prisma.config.ts, lib/prisma.ts)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supportly?schema=public"
