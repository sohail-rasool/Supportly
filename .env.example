# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this template is committed so others know which variables are needed.

# PostgreSQL connection string, used by Prisma (prisma.config.ts, lib/prisma.ts)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/supportly?schema=public"

# Better Auth
# Random 32+ char secret: `npx auth@latest secret` or `openssl rand -base64 32`
BETTER_AUTH_SECRET="<RANDOM_SECRET>"
# Public URL of this app (use your tunnel URL when connecting the dashboard)
BETTER_AUTH_URL="http://localhost:3000"
# From the Better Auth dashboard
BETTER_AUTH_API_KEY="<API_KEY>"
# AI provider: set ONE of these keys. OpenRouter wins if both are set.
# Free key: https://openrouter.ai/keys  (models ending in ":free" cost nothing)
OPENROUTER_API_KEY="<OPENROUTER_API_KEY>"
# Paid OpenAI key (needs credits on platform.openai.com)
OPENAI_API_KEY="<OPENAI_API_KEY>"
# Optional model override. Defaults: nvidia/nemotron-3.5-lightning:free (OpenRouter), gpt-4o-mini (OpenAI)
# AI_MODEL="nvidia/nemotron-3.5-lightning:free"
# Optional OpenRouter fallbacks, tried when the main model is busy (comma-separated)
# AI_FALLBACK_MODELS="nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free"
